# ---------------------------------------------------------------------------
# Tracer configuration
# ---------------------------------------------------------------------------
# Tracer ships with a deterministic SIMULATED model provider so the whole
# system runs with no credentials at all. Set MODEL_PROVIDER to a live
# provider to run the identical agent loop against a real LLM.
#
#   simulated  (default) deterministic, no network, no key
#   openai     OpenAI Chat Completions with native tool calling
#   vertex     Google Vertex AI (Gemini) with function calling
# ---------------------------------------------------------------------------
MODEL_PROVIDER=simulated

PORT=8787

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Vertex AI (Gemini) ---------------------------------------------
# Auth uses Application Default Credentials:  gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-pro
# Optional: use a plain Gemini API key instead of ADC (AI Studio endpoint)
GEMINI_API_KEY=
